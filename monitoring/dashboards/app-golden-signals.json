      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"vault-forge\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx Errors"
        }
      ]
